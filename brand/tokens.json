{
  "$schema": "https://tr.designtokens.org/format/draft/",
  "meta": { "project": "PolyGM", "source": "derived from polymarket.com compiled CSS (inspiration only), roles original", "theme": "dark-first" },
  "color": {
    "brand": {
      "50":  { "dark": "#020041", "light": "#f4fcff" },
      "100": { "dark": "#060071", "light": "#cadfff" },
      "200": { "dark": "#0d00a8", "light": "#a0c1ff" },
      "300": { "dark": "#1020c9", "light": "#76a2ff" },
      "400": { "dark": "#1e44e7", "light": "#4e7fff" },
      "500": { "dark": "#3262ff", "light": "#2e5cff", "$note": "primary action" },
      "600": { "dark": "#5485ff", "light": "#1c3fe2" },
      "700": { "dark": "#7ba5ff", "light": "#0f1ac6" },
      "800": { "dark": "#a1c0ff", "light": "#0c00a4" },
      "900": { "dark": "#c7daff", "light": "#06006f" }
    },
    "neutral": {
      "50":  { "dark": "#0c0e13", "light": "#ffffff", "$note": "base surface" },
      "100": { "dark": "#1c1f27", "light": "#f4f5f7", "$note": "elevated" },
      "200": { "dark": "#2d3037", "light": "#e6e8ec", "$note": "border" },
      "300": { "dark": "#45474e", "light": "#d4d7dc" },
      "400": { "dark": "#62646a", "light": "#bfc3ca" },
      "500": { "dark": "#7d8189", "light": "#abb2bb" },
      "600": { "dark": "#8b929b", "light": "#999ea7", "$note": "secondary text (AA on 50)" },
      "900": { "dark": "#23272d", "light": "#edeff1" },
      "950": { "dark": "#000000", "light": "#ffffff" }
    },
    "text": {
      "primary": { "dark": "#e6edf3", "light": "#1f2937" },
      "secondary": { "dark": "#8b929b", "light": "#6b727b" }
    },
    "semantic": {
      "yes": "#16a34a",
      "no": "#ef4444",
      "warning": "#f1ce57",
      "whale": "#f1ce57",
      "action": "#2e5cff",
      "actionHover": "#5485ff",
      "onAction": "#ffffff"
    },
    "chart": ["#87BFFF", "#4378FF", "#2797FF", "#FDC503", "#FF7F0E", "#144E8C", "#7ba5ff", "#f1ce57"]
  },
  "typography": {
    "display": "Instrument Sans Condensed",
    "body": "Inter Variable",
    "mono": "Geist Mono",
    "scale": [
      { "name": "xs", "size": 11, "line": 1.35 },
      { "name": "sm", "size": 12, "line": 1.4 },
      { "name": "md", "size": 14, "line": 1.45 },
      { "name": "lg", "size": 16, "line": 1.4 },
      { "name": "xl", "size": 20, "line": 1.3 },
      { "name": "2xl", "size": 24, "line": 1.25 },
      { "name": "3xl", "size": 32, "line": 1.2 }
    ]
  },
  "radius": { "base": "0.7rem", "xs": "-6px", "sm": "-4px", "md": "-2px", "xl": "+4px", "2xl": "1rem", "3xl": "1.5rem" },
  "spacing": [4, 8, 12, 16, 24, 32, 48]
}
