  "chart": {
    "note": "Adopted arrays are copied from tools/palette-search.py's exhaustive \u0394E*ab search output (brand/palette-search.json), NOT hand-picked \u2014 a hand-picked list here broke the bar and was caught by tools/p02-gate-check.py G9.",
    "perThemeCount": {
      "dark": 8,
      "light": 6
    },
    "whyNotEightEverywhere": "searched per size: dark reaches 8 at worst \u0394E*ab 11.3; light's best 6 is 13.4 but a 7th colour drops it to 9.1, so light ships 6 and extends by dash+marker. Note the arrays are searched AT their own size \u2014 slicing a bigger result inherits a different optimum.",
    "dashExtension": "series 7+ (and light 7+) reuse core hues at a different lightness and are separated by dash pattern + marker shape, never by hue alone",
    "legendText": "text.secondary (\u22654.5:1) \u2014 3 of 8 dark series hues sit at 3.0-3.9:1, so they are line-safe, not text-safe",
    "dark": [
      "#f1ce57",
      "#E69F00",
      "#D55E00",
      "#7C4DEB",
      "#16C79A",
      "#9BA6B2",
      "#6b727b",
      "#e6edf3"
    ],
    "light": [
      "#4378FF",
      "#144E8C",
      "#D55E00",
      "#EF7A5A",
      "#CC79A7",
      "#7C4DEB"
    ],
    "contrastFloor": {
      "dark": 3,
      "light": 2.25
    },
    "worstDeltaE": {
      "dark": 11.3,
      "light": 13.4
    }
  },
  "rules": {
    "never-same-row": {
      "outcome.no": [
        "alert.critical"
      ],
      "reason": "measured \u0394E*ab 4.1 (dark) / 3.2 (light) between #D55E00 and the critical hue \u2014 indistinguishable to deuteranopes, so layout must separate them"
    },
    "outcome-never-green-red": "an outcome is a side, not a verdict; green/red are reserved for action and result",
    "colour-never-alone": "yes/no carry a word label + fixed L/R slot; profit/loss carry +/\u2212; tape sides carry \u25b2/\u25bc",
    "mark-min-size-px": 24,
    "below-24px-use": "brand/svg/favicon.svg (stroke 6u, dot r 6u \u2014 measured 19.4px\u00b2 per chevron at 16px)",
    "action-buy-aliases-result-profit": "same hex by design (\u0394E 0.0); disambiguated by slot and sign glyph",
    "no-floats-in-money-path": "token hex strings are the only colour truth; UI never renders raw numbers (AGENTS 6)",
    "brand-primary-is-not-body-text": "#2e5cff on #0c0e13 measures 3.76:1 \u2014 legal only for large/bold UI text and controls; for body-size link text use brand.primary-text (#4e7fff dark = 6.28:1, #1c3fe2 light = 7.35:1). This rule exists because the audit flagged it, not because I assumed it."
  },
  "typographyRevision": {
    "status": "proposed field revised; Brand Lock's Instrument Sans Condensed has no verifiable distribution",
    "display": {
      "family": "Archivo Narrow",
      "weights": [
        600,
        700
      ],
