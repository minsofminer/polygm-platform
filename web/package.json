{
  "name": "openout-web",
  "version": "0.0.0",
  "private": true,
  "description": "Openout shell (P08). Consumes brand/tokens.json via web/tailwind.preset.cjs and the P07 security plane. No design token is redefined here.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/assert-env.mjs && next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.gen.ts --header \"generated by npm run gen:api from contracts/openapi.yaml - do not edit; the P08 gate re-runs it and fails on drift\"",
    "check:api": "node scripts/check-generated.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "measure": "node scripts/measure-first-load.mjs",
    "pretest": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
