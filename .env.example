# P04 · copy to .env and edit. NO REAL VALUES IN THIS FILE (P04 constraint: no secrets in code).
# Every line is the flag the service reads, what it means, and who owns it. Empty means "unset", which for
# several of these means "the service refuses to start" — that is intended, not an omission.

# ---- engine ------------------------------------------------------------------
POLYGM_ENGINE=postgres                  # postgres | sqlite. sqlite is dev/CI ONLY; readiness says so.
PGM_DB_URL=postgresql://polygm:polygm@pgbouncer:6432/polygm
PGM_DB_PATH=var/polygm.db               # sqlite path, used when POLYGM_ENGINE=sqlite
PGM_REDIS_URL=redis://redis:6379/0      # caches only; idempotency keys live in Postgres
PGM_DB_POOL_MAX=20                      # keep below pgBouncer's DEFAULT_POOL_SIZE

# ---- venue -------------------------------------------------------------------
PGM_CLOB_HOST=https://clob.polymarket.com
PGM_GAMMA_HOST=https://gamma-api.polymarket.com
PGM_TAPE_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PGM_MOCK_CLOB_URL=http://executor-mock:8090
POLYGM_TRANSPORT=mock                   # mock | live. live requires the signer and is gated on P13/P14.
PGM_BUILDER_CODE=                       # from the builder registration flow (D2/D4); never in code

# ---- signing (NEVER commit a value here; mount from a secret store) ----------
POLYGM_SIGNER_URL=                      # KMS/HSM endpoint, not a key
POLYGM_SIGNER_KEY_ID=                   # an identifier is safe to commit; the key material is not
POLYGM_SIGNER_PUBKEY=                   # public half; used to derive client_order_hash

# ---- limits/budgets (measured in P01; see docs/verification/P01-probe.json) --
PGM_GAMMA_PER_10S=300
PGM_BALANCE_PER_10S=200
PGM_MAX_ORDER_NOTIONAL_MICRO=2500000000
PGM_MAX_24H_NOTIONAL_MICRO=25000000000
PGM_STALE_MS_BOOK=3000
PGM_STALE_MS_TAPE=3000
PGM_STALE_MS_METADATA=120000

# ---- api ---------------------------------------------------------------------
PGM_LOG_FORMAT=json
PGM_REQUEST_ID_HEADER=x-request-id
PGM_CORS_ORIGINS=http://localhost:5173  # comma separated; never "*" with credentials
PGM_AUTH_MODE=dev-header                # dev-header | bearer. dev-header trusts X-User-Id, so compose
                                        # binds 127.0.0.1 only; anything else must be bearer.
PGM_ADMIN_TOKEN=                        # required for /v1/admin/*; empty => the endpoint is 503

# ---- telegram / billing (P09+, listed here so the schema has one home) -------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
